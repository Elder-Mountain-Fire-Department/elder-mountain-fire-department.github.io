---
layout: base.njk
title: Photo gallery
description: Photos of Elder Mountain Fire Department training, apparatus, and calls.
permalink: /photo-gallery/
---
<article class="page">
  <header class="page-head">
    <h1>Photo gallery</h1>
    <p class="lede">Training, apparatus, and calls.</p>
  </header>
  <ul class="masonry">
  {%- for p in gallery %}
    <li id="{{ p.file | replace('.jpg', '') }}">
      <figure>
        <img src="/img/photos/{{ p.file }}" alt="{{ p.alt }}" sizes="(min-width: 1000px) 33vw, (min-width: 600px) 50vw, 100vw">
        <figcaption>{{ p.caption }}</figcaption>
      </figure>
    </li>
  {%- endfor %}
  </ul>
</article>
