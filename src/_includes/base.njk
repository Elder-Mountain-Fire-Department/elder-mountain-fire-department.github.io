<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% if title and page.url != "/" %}{{ title }} | {% endif %}{{ site.name }}</title>
<meta name="description" content="{{ description or site.tagline }}">
{%- if noindex %}<meta name="robots" content="noindex">{% endif %}
<link rel="canonical" href="{{ site.url }}{{ page.url }}">
<meta property="og:title" content="{{ title or site.name }}">
<meta property="og:description" content="{{ description or site.tagline }}">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
<meta property="og:image" content="{{ site.url }}/img/brand/emvfd-logo.png">
<meta name="theme-color" content="#1d3122">
<link rel="icon" href="/favicon.ico" sizes="any">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="manifest" href="/site.webmanifest">
<link rel="preload" href="/fonts/plus-jakarta-sans-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/css/site.css">
</head>
<body{% if bodyClass %} class="{{ bodyClass }}"{% endif %}>
<a class="skip" href="#main">Skip to content</a>
<p class="emergency"><span class="wrap"><strong>Emergency? Call 911.</strong> Do not use this website or email to report one.</span></p>
<header class="site-head">
  <div class="wrap head-row">
    <a class="brand" href="/">
      <img src="/img/brand/emvfd-logo.png" alt="" width="56" height="56" eleventy:ignore>
      <span class="brand-name">Elder Mountain <span>Volunteer Fire Department</span></span>
    </a>
    <nav class="site-nav" aria-label="Main">
      <ul>
      {%- for item in nav %}
        <li><a href="{{ item.url }}"{% if page.url == item.url %} aria-current="page"{% endif %}>{{ item.label }}</a></li>
      {%- endfor %}
      </ul>
    </nav>
  </div>
</header>
<main id="main">
{{ content | safe }}
</main>
<footer class="site-foot">
  <div class="wrap foot-grid">
    <div>
      <p class="foot-name">{{ site.name }}</p>
      <p>A 501(c)(3) nonprofit, all-volunteer fire department.</p>
      <p><a href="{{ site.facebook }}">Follow us on Facebook</a></p>
    </div>
    <div>
      <p class="foot-label">Station</p>
      <p>{{ site.station.street }}<br>{{ site.station.city }}</p>
    </div>
    <div>
      <p class="foot-label">Mailing address</p>
      <p>{{ site.mailing.street }}<br>{{ site.mailing.city }}</p>
    </div>
    <div>
      <p class="foot-label">General questions</p>
      <p><a href="mailto:{{ site.email }}">{{ site.email }}</a></p>
      <p class="foot-911">For emergencies, dial 911.</p>
    </div>
  </div>
  <div class="wrap foot-base">© {{ "" | year }} {{ site.name }}</div>
</footer>
</body>
</html>
