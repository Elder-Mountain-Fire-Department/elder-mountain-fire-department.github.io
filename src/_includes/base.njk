<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{% if title and page.url != "/" %}{{ title }} | {% endif %}{{ site.name }}</title>
<meta name="description" content="{{ description or site.tagline }}">
{%- if noindex %}<meta name="robots" content="noindex">{% endif %}
<link rel="canonical" href="{{ site.url }}{{ page.url }}">
<meta property="og:title" content="{{ title or site.name }}">
<meta property="og:description" content="{{ description or site.tagline }}">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
<meta property="og:image" content="{{ site.url }}/img/brand/emvfd-logo.png">
<meta name="theme-color" content="#ffffff">
<link rel="icon" href="/favicon.ico?v={{ build.v }}" sizes="any">
<link rel="apple-touch-icon" href="/apple-touch-icon.png?v={{ build.v }}">
<link rel="manifest" href="/site.webmanifest?v={{ build.v }}">
<link rel="preload" href="/fonts/plus-jakarta-sans-latin-wght-normal.woff2?v={{ build.v }}" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/css/site.css?v={{ build.v }}">
</head>
<body{% if bodyClass %} class="{{ bodyClass }}"{% endif %}>
<script>document.documentElement.classList.add("js")</script>
<a class="skip" href="#main">Skip to content</a>
<header class="site-head{% if page.url == "/" %} over{% endif %}">
  <div class="wrap head-row">
    <a class="brand" href="/">
      <img src="/img/brand/emvfd-logo.png?v={{ build.v }}" alt="" width="56" height="56" eleventy:ignore>
      <span class="brand-name">Elder Mountain <span>Fire Department</span></span>
    </a>
    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav">Menu</button>
    <nav class="site-nav" id="site-nav" aria-label="Main">
      <ul>
      {%- for item in nav %}
        <li><a href="{{ item.url }}"{% if page.url == item.url %} aria-current="page"{% endif %}>{{ item.label }}</a></li>
      {%- endfor %}
      </ul>
    </nav>
  </div>
</header>
<main id="main">
{{ content | safe }}
</main>
<footer class="site-foot">
  <div class="wrap foot-grid">
    <div>
      <p class="foot-name">{{ site.name }}</p>
      <p>A 501(c)(3) nonprofit, all-volunteer fire department.</p>
      <p><a href="{{ site.facebook }}">Follow us on Facebook</a></p>
    </div>
    <div>
      <p class="foot-label">Station</p>
      <p>{{ site.station.street }}<br>{{ site.station.city }}</p>
    </div>
    <div>
      <p class="foot-label">Mailing address</p>
      <p>{{ site.mailing.street }}<br>{{ site.mailing.city }}</p>
    </div>
    <div>
      <p class="foot-label">General questions</p>
      <p><a href="tel:{{ site.phoneTel }}">{{ site.phone }}</a><br><a href="mailto:{{ site.email }}">{{ site.email }}</a></p>
      <p><a href="/emfd-members-page/">Members page</a></p>
    </div>
  </div>
  <div class="wrap foot-base">© {{ "" | year }} {{ site.name }}</div>
</footer>
<script>
(function () {
  var head = document.querySelector(".site-head"), btn = head.querySelector(".nav-toggle");
  function set(open) { head.classList.toggle("open", open); btn.setAttribute("aria-expanded", open ? "true" : "false"); btn.textContent = open ? "Close" : "Menu"; }
  btn.addEventListener("click", function () { set(!head.classList.contains("open")); });
  document.addEventListener("keydown", function (e) { if (e.key === "Escape" && head.classList.contains("open")) { set(false); btn.focus(); } });
  head.querySelectorAll(".site-nav a").forEach(function (a) { a.addEventListener("click", function () { set(false); }); });
})();
</script>
{%- if page.url == "/" %}
<script>
(function () {
  // Fade the header from clear to white over the first half of the banner.
  var head = document.querySelector(".site-head.over"), hero = document.querySelector(".hero");
  function update() {
    var p = Math.min(1, Math.max(0, window.scrollY / (hero.offsetHeight * 0.5)));
    head.style.setProperty("--fade", p.toFixed(3));
    head.classList.toggle("dark", p >= 0.45);
    head.classList.toggle("solid", p >= 1);
  }
  window.addEventListener("scroll", update, { passive: true });
  window.addEventListener("resize", update);
  update();
})();
</script>
{%- endif %}
</body>
</html>
