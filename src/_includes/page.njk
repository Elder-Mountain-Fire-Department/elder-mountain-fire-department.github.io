---
layout: base.njk
---
<article class="page doc">
  <header class="page-head">
    <h1>{{ title }}</h1>
    {%- if lede %}<p class="lede">{{ lede }}</p>{% endif %}
  </header>
  {%- if image %}
  <figure class="page-photo"><img src="/img/photos/{{ image }}" alt="{{ imageAlt }}" sizes="(min-width: 1100px) 1040px, 100vw"></figure>
  {%- endif %}
  <div class="prose">
{{ content | safe }}
  </div>
</article>
