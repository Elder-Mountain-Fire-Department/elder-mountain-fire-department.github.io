{#- The one contact form (on /contact/). Sends through Web3Forms to the address the key in site.formKey is registered to (info@eldervfd.org). -#}
{%- if site.formKey %}
<form class="contact-form" action="https://api.web3forms.com/submit" method="POST">
  <input type="hidden" name="access_key" value="{{ site.formKey }}">
  <input type="hidden" name="subject" value="[EMFD] Website message">
  <input type="hidden" name="from_name" value="eldervfd.org">
  <input type="hidden" name="redirect" value="{{ site.url }}/thanks/">
  <input type="checkbox" name="botcheck" class="botcheck" tabindex="-1" autocomplete="off" aria-hidden="true">
  <label for="f-topic">I want to</label>
  <select id="f-topic" name="topic" required>
    <option value="Volunteering / membership">Volunteer or join the department</option>
    <option value="Information request" selected>Ask a question or request information</option>
  </select>
  <label for="f-name">Name</label>
  <input id="f-name" name="name" type="text" autocomplete="name" required>
  <div class="row">
    <div><label for="f-email">Email</label>
    <input id="f-email" name="email" type="email" autocomplete="email" required></div>
    <div><label for="f-phone">Phone <span class="opt">(optional)</span></label>
    <input id="f-phone" name="phone" type="tel" autocomplete="tel"></div>
  </div>
  <label for="f-message" id="f-message-label">Message</label>
  <textarea id="f-message" name="message" rows="4" required></textarea>
  <button class="button" type="submit">Send</button>
  <p class="form-status" role="status" aria-live="polite"></p>
</form>
<script>
(function () {
  var f = document.querySelector(".contact-form"), s = f.querySelector(".form-status"), b = f.querySelector("button");
  var topic = f.querySelector("#f-topic"), label = f.querySelector("#f-message-label");
  var join = "Volunteering / membership";
  function sync() {
    var j = topic.value === join;
    f.subject.value = j ? "[EMFD] Volunteer application" : "[EMFD] Information request";
    label.textContent = j ? "Tell us a little about yourself and how you would like to help" : "Message";
  }
  if (/[?&]topic=join\b/.test(location.search)) topic.value = join;
  topic.addEventListener("change", sync);
  sync();
  f.addEventListener("submit", function (e) {
    e.preventDefault();
    b.disabled = true;
    s.className = "form-status";
    s.textContent = "Sending…";
    fetch(f.action, { method: "POST", headers: { Accept: "application/json" }, body: new FormData(f) })
      .then(function (r) { return r.json(); })
      .then(function (d) {
        if (!d.success) throw new Error(d.message);
        f.reset();
        sync();
        s.classList.add("ok");
        s.textContent = "Thank you. We will get back to you as soon as we can.";
      })
      .catch(function () {
        s.classList.add("err");
        s.innerHTML = "That did not go through. Please email <a href=\"mailto:{{ site.email }}\">{{ site.email }}</a> instead.";
      })
      .finally(function () { b.disabled = false; });
  });
})();
</script>
{%- else %}
<p><a class="button" href="mailto:{{ site.email }}">Email {{ site.email }}</a></p>
{%- endif %}
