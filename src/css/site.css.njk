---
permalink: /css/site.css
eleventyExcludeFromCollections: true
---
/* Plus Jakarta Sans, the typeface of the original eldervfd.org, as one variable font (weights 200-800). */
@font-face { font-family: "Plus Jakarta Sans"; font-style: normal; font-weight: 200 800; font-display: swap; src: url(/fonts/plus-jakarta-sans-latin-wght-normal.woff2?v={{ build.v }}) format("woff2-variations"); }
@font-face { font-family: "Plus Jakarta Sans"; font-style: italic; font-weight: 200 800; font-display: swap; src: url(/fonts/plus-jakarta-sans-latin-wght-italic.woff2?v={{ build.v }}) format("woff2-variations"); }

:root {
  --ink: #1a1a1a;        /* the original site's charcoal */
  --ink-soft: #5a5d61;
  --paper: #ffffff;
  --mist: #f3f4f2;       /* light sections */
  --rule: #e2e3e0;
  --red: #d01f16;        /* the department logo's red: 911 line and buttons */
  --red-dark: #a8170f;
  --font: "Plus Jakarta Sans", system-ui, sans-serif;
  --max: 1240px;
  --gutter: max(clamp(20px, 4vw, 56px), env(safe-area-inset-left), env(safe-area-inset-right));
  --edge: max(var(--gutter), calc((100vw - var(--max)) / 2 + var(--gutter)));
  --space: clamp(72px, 10vw, 140px);
}

* { box-sizing: border-box; }
html { -webkit-text-size-adjust: 100%; scroll-padding-top: 96px; }
@media (prefers-reduced-motion: no-preference) { html { scroll-behavior: smooth; } }
body { margin: 0; background: var(--paper); color: var(--ink); font: 400 1.125rem/1.7 var(--font); }
img { max-width: 100%; height: auto; display: block; }
a { color: inherit; text-decoration-thickness: 1px; text-underline-offset: 0.2em; }
a:hover { text-decoration-thickness: 2px; }
h1, h2, h3 { font-weight: 600; letter-spacing: -0.02em; line-height: 1.1; margin: 0 0 0.5em; text-wrap: balance; }
h2 { font-size: clamp(1.9rem, 3.2vw, 2.7rem); }
p, ul { margin: 0 0 1em; }
:focus-visible { outline: 3px solid var(--red); outline-offset: 3px; }
.visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }

.wrap { display: block; max-width: var(--max); margin: 0 auto; padding: 0 var(--gutter); }
.skip { position: absolute; left: -999px; top: 0; background: var(--paper); padding: 8px 12px; z-index: 10; }
.skip:focus { left: 8px; }

/* Header stays at the top while scrolling: a white bar on inner pages; on the home page it starts clear over the photo
   and turns white once the photo has scrolled away (script in base.njk). */
.site-head { background: var(--paper); border-bottom: 1px solid var(--rule); position: sticky; top: 0; z-index: 20; padding-top: env(safe-area-inset-top); }
/* Home: clear over the photo, fading to white as the banner scrolls away (--fade 0 to 1, set by the script in base.njk) */
.site-head.over { --fade: 0; position: fixed; left: 0; right: 0; background: rgba(255, 255, 255, calc(var(--fade) * 0.97)); border-bottom-color: rgba(226, 227, 224, var(--fade)); color: #fff; }
.site-head.over.dark { color: var(--ink); }
.site-head.over.solid { background: rgba(255, 255, 255, 0.97); color: var(--ink); border-bottom-color: var(--rule); }
.head-row { display: flex; align-items: center; justify-content: space-between; gap: 12px 28px; flex-wrap: wrap; padding-top: 18px; padding-bottom: 18px; }
.brand { display: flex; align-items: center; gap: 14px; text-decoration: none; }
.brand img { width: 52px; height: 52px; }
.brand-name { font-weight: 700; font-size: 1.1rem; line-height: 1.2; letter-spacing: -0.01em; }
.brand-name span { display: block; font-weight: 400; font-size: 0.9rem; opacity: 0.75; letter-spacing: 0; }
.site-nav ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 4px 30px; }
.site-nav a { text-decoration: none; font-weight: 500; font-size: 1rem; padding: 6px 0; }
.site-nav a:hover, .site-nav a[aria-current] { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 0.45em; }

/* Phones: the menu folds behind a button so the pinned header stays one line */
.nav-toggle { display: none; font: 600 1rem/1 var(--font); color: inherit; background: transparent; border: 1.5px solid currentColor; border-radius: 4px; padding: 10px 14px; cursor: pointer; }
@media (max-width: 760px) {
  .head-row { flex-wrap: wrap; padding-top: 10px; padding-bottom: 10px; row-gap: 0; }
  .brand img { width: 42px; height: 42px; }
  .brand-name { font-size: 1rem; }
  .brand-name span { font-size: 0.85rem; }
  .js .nav-toggle { display: block; }
  .js .site-nav { display: none; width: 100%; }
  .js .site-head.open .site-nav { display: block; }
  .site-nav ul { flex-direction: column; gap: 0; padding: 6px 0 4px; }
  .site-nav a { display: block; padding: 13px 0; font-size: 1.1rem; border-top: 1px solid var(--rule); }
  .site-nav li:first-child a { border-top: 0; }
  .site-head.over.open { background: rgba(255, 255, 255, 0.98); color: var(--ink); }
  .site-head.over .site-nav a { border-top-color: rgba(255, 255, 255, 0.25); }
  .site-head.over.open .site-nav a, .site-head.over.solid .site-nav a { border-top-color: var(--rule); }
  .site-nav a:hover, .site-nav a[aria-current] { text-decoration: none; font-weight: 700; }
}

/* Buttons and links */
.button { display: inline-block; background: var(--red); color: #fff; font: 600 1rem/1 var(--font); text-decoration: none; padding: 16px 28px; border: 2px solid var(--red); border-radius: 4px; cursor: pointer; }
.button:hover { background: var(--red-dark); border-color: var(--red-dark); }
.button:disabled { opacity: 0.6; cursor: wait; }
.text-link { font-weight: 600; text-decoration: underline; }

/* Home: the gorge sticks to the top of the screen while the page scrolls up over it. It is sized to the large viewport
   (Safari's toolbars hidden) so it always fills the screen; the text and arrow are lifted by the toolbar height so they sit
   in the visible area when the page first loads. */
.hero-bg { position: sticky; top: 0; z-index: 0; height: 100vh; height: 100lvh; margin-bottom: -100vh; margin-bottom: -100lvh; overflow: hidden; background: #2b3a2c; }
.hero { position: relative; z-index: 1; min-height: 100vh; min-height: 100lvh; display: flex; align-items: flex-end; color: #fff; --toolbar: 0px; }
@supports (height: 100lvh) { .hero { --toolbar: calc(100lvh - 100svh); } }
.hero-bg img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 60%; }
.hero-bg::after { content: ""; position: absolute; inset: 0; background: rgba(26, 26, 26, 0.42); }
.hero-words { position: relative; padding: 140px var(--gutter) calc(var(--toolbar) + clamp(112px, 16vh, 168px)) var(--edge); max-width: calc(var(--edge) + 46rem); }
.hero-name { font-size: clamp(1.15rem, 1.7vw, 1.45rem); font-weight: 700; letter-spacing: -0.01em; margin: 0 0 0.7em; }
.hero-lede { font-size: clamp(1.3rem, 2.1vw, 1.85rem); font-weight: 300; font-style: italic; line-height: 1.35; letter-spacing: -0.01em; color: #fff; margin: 0; text-wrap: pretty; }
.hero-911 { color: var(--red); font-weight: 800; font-size: clamp(1.5rem, 2.5vw, 2.1rem); letter-spacing: -0.01em; margin: 0.9em 0 0; text-shadow: 0 1px 14px rgba(0, 0, 0, 0.45); }
.scroll-cue { position: absolute; left: 50%; bottom: calc(var(--toolbar) + clamp(20px, 4vh, 40px) + env(safe-area-inset-bottom)); translate: -50% 0; color: #fff; padding: 8px; border-radius: 50%; }
.scroll-cue svg { display: block; filter: drop-shadow(0 1px 6px rgba(0, 0, 0, 0.4)); }
@media (prefers-reduced-motion: no-preference) {
  .scroll-cue svg { animation: bob 2s ease-in-out infinite; }
  @keyframes bob { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(10px); } }
}
.over-hero { position: relative; z-index: 1; background: var(--paper); }

/* Home: response */
.response { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(32px, 6vw, 96px); align-items: center; max-width: var(--max); margin: 0 auto; padding: var(--space) var(--gutter); }
.response-photo { margin: 0; }
.response-photo img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: 4px; }
.response-text > p { color: var(--ink-soft); }
.calls { list-style: none; padding: 0; margin-top: 1.6em; border-top: 1px solid var(--rule); }
.calls li { font-weight: 500; padding: 14px 0; border-bottom: 1px solid var(--rule); }

/* Home: today's fire danger (filled in by burn.js) */
.burn-home { max-width: var(--max); margin: 0 auto; padding: 0 var(--gutter) var(--space); }
.burn-home-inner { display: grid; grid-template-columns: 1fr 1fr; gap: 16px clamp(32px, 6vw, 96px); align-items: end; }
.burn-home .rating-word { font-size: clamp(2.6rem, 5.5vw, 4.2rem); }
.burn-home .rating-scale { margin-bottom: 0; }
.burn-home .rating-advice { margin-bottom: 0.6em; }

/* Home: join */
.join { background: var(--mist); }
.join-inner { display: grid; grid-template-columns: 7fr 5fr; gap: clamp(32px, 6vw, 96px); align-items: center; max-width: var(--max); margin: 0 auto; padding: var(--space) var(--gutter); }
.join-photo { margin: 0; }
.join-photo img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: 4px; }
.join-text p { color: var(--ink-soft); }
.join-text .button { margin-top: 0.6em; }

/* Home: photos */
.recent { max-width: var(--max); margin: 0 auto; padding: var(--space) var(--gutter); }
.recent-head { display: flex; justify-content: space-between; align-items: baseline; gap: 8px 24px; flex-wrap: wrap; margin-bottom: 28px; }
.recent-head h2 { margin: 0; }
.mosaic { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 2fr 1fr 1fr; grid-template-rows: repeat(2, minmax(180px, 20vw)); gap: 10px; max-height: 600px; }
.mosaic li:first-child { grid-row: span 2; }
.mosaic li:last-child { grid-column: span 2; }
.mosaic a, .mosaic picture { display: block; height: 100%; }
.mosaic img { width: 100%; height: 100%; object-fit: cover; border-radius: 4px; }

/* Inner pages */
.page { max-width: var(--max); margin: 0 auto; padding: 0 var(--gutter) var(--space); }
.page-head { padding: clamp(48px, 7vw, 96px) 0 clamp(28px, 4vw, 44px); max-width: 52rem; }
.page-head h1 { font-size: clamp(2.5rem, 5vw, 4rem); margin: 0; }
.lede { font-size: clamp(1.2rem, 2vw, 1.5rem); font-weight: 400; line-height: 1.45; color: var(--ink-soft); margin: 0.6em 0 0; max-width: 36em; }
.page-photo { margin: 0 0 clamp(36px, 5vw, 64px); }
.page-photo img { width: 100%; aspect-ratio: 21 / 9; object-fit: cover; border-radius: 4px; }
.prose { max-width: 40rem; }
.prose h2 { font-size: clamp(1.5rem, 2.4vw, 1.9rem); margin-top: 1.5em; }
.prose ul { padding-left: 1.2em; }
.prose li { margin-bottom: 0.4em; }
.callout { background: var(--mist); padding: 16px 20px; border-radius: 4px; }
.addr-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; margin-top: 56px; padding-top: 28px; border-top: 1px solid var(--rule); }
.prose .addr-grid h2 { font-size: 1.05rem; letter-spacing: 0; margin: 0 0 0.3em; }

/* Join or contact: information and form side by side, sized to fit one screen on a laptop or desktop */
.contact { max-width: var(--max); margin: 0 auto; padding: clamp(20px, 4vh, 56px) var(--gutter); display: grid; grid-template-columns: 5fr 6fr; gap: clamp(32px, 6vw, 96px); align-items: center; min-height: calc(100vh - 89px); min-height: calc(100svh - 89px); }
.contact h1 { font-size: clamp(2.2rem, 4vw, 3.2rem); margin-bottom: 0.3em; }
.contact .lede { font-size: clamp(1.1rem, 1.5vw, 1.25rem); margin: 0 0 1.2em; }
.contact-911 { background: var(--mist); padding: 12px 16px; border-radius: 4px; font-size: 1rem; }
.contact-911 strong { color: var(--red); }
.contact-facts { display: grid; grid-template-columns: 1fr 1fr; gap: 16px 24px; margin: 24px 0 0; font-size: 1rem; line-height: 1.5; }
.contact-facts div:last-child { grid-column: span 2; }
.contact-facts dt { font-weight: 600; }
.contact-facts dd { margin: 0; color: var(--ink-soft); }
.contact-form-wrap { background: var(--mist); border-radius: 6px; padding: clamp(18px, 2.4vw, 30px); }
.contact-form-wrap textarea { height: clamp(80px, 15vh, 140px); }
.contact-form-wrap .form-status:empty { display: none; }
.contact-form-wrap .contact-form { max-width: none; gap: 4px; }
.contact-form-wrap .contact-form label { margin-top: 10px; font-size: 0.95rem; }
.contact-form-wrap .contact-form label:first-of-type { margin-top: 0; }
.contact-form-wrap .contact-form input, .contact-form-wrap .contact-form textarea, .contact-form-wrap .contact-form select { padding: 10px 12px; }
.contact-form .row { display: grid; grid-template-columns: 1fr 1fr; gap: 0 14px; }
.contact-form .row > div { display: grid; gap: 4px; }

/* Burn conditions */
.burn { max-width: 60rem; margin: 0 auto; padding: 0 var(--gutter) var(--space); }
.burn-head { padding: clamp(40px, 6vw, 80px) 0 clamp(20px, 3vw, 32px); }
.burn-head h1 { font-size: clamp(2.4rem, 5vw, 3.6rem); margin: 0; }
.burn-date { color: var(--ink-soft); margin: 0.3em 0 0; font-size: 1.15rem; }
.rating { border-top: 1px solid var(--ink); padding-top: 22px; }
.rating-label { font-weight: 600; margin: 0; }
.rating-word { font-size: clamp(3rem, 8vw, 5.2rem); font-weight: 700; letter-spacing: -0.035em; line-height: 1; margin: 0.08em 0 0.25em; color: var(--ink); }
.rating[data-c="vl"] .rating-word { color: var(--c-vl); } .rating[data-c="l"] .rating-word { color: var(--c-l); }
.rating[data-c="m"] .rating-word { color: var(--c-m-text); } .rating[data-c="h"] .rating-word { color: var(--c-h); }
.rating[data-c="vh"] .rating-word { color: var(--c-vh); }
.rating-scale { list-style: none; margin: 0 0 24px; padding: 0; display: grid; grid-template-columns: repeat(5, 1fr); gap: 4px; max-width: 34rem; font-size: 0.85rem; color: var(--ink-soft); }
.rating-scale li { border-top: 6px solid var(--c); padding-top: 6px; opacity: 0.4; }
.rating-scale li.on { opacity: 1; color: var(--ink); font-weight: 700; }
.rating-advice { font-size: clamp(1.15rem, 2vw, 1.35rem); line-height: 1.5; max-width: 40rem; margin: 0 0 0.8em; }
.rating.stop .rating-advice { color: var(--red); font-weight: 600; }
.rating-meta { font-size: 0.9rem; color: var(--ink-soft); margin: 0; }
:root { --c-vl: #2e7d32; --c-l: #1565c0; --c-m: #e0b000; --c-m-text: #8a6d00; --c-h: #d84f00; --c-vh: #c62828; }
[data-c="vl"] { --c: var(--c-vl); } [data-c="l"] { --c: var(--c-l); } [data-c="m"] { --c: var(--c-m); } [data-c="h"] { --c: var(--c-h); } [data-c="vh"] { --c: var(--c-vh); }
.cls-vl { color: var(--c-vl); } .cls-l { color: var(--c-l); } .cls-m { color: var(--c-m-text); } .cls-h { color: var(--c-h); } .cls-vh { color: var(--c-vh); }
td.cls-vl, td.cls-l, td.cls-m, td.cls-h, td.cls-vh { font-weight: 700; }
.burn-section { padding-top: clamp(44px, 6vw, 72px); }
.burn-section h2 { font-size: clamp(1.6rem, 2.6vw, 2.1rem); }
.table-wrap { overflow-x: auto; }
.cond { width: 100%; border-collapse: collapse; font-size: 1rem; }
.cond th, .cond td { text-align: left; padding: 11px 14px 11px 0; border-bottom: 1px solid var(--rule); vertical-align: top; }
.cond thead th { font-weight: 700; border-bottom: 1px solid var(--ink); }
.cond thead th span { display: block; font-weight: 400; font-size: 0.85rem; color: var(--ink-soft); }
.cond tbody th { font-weight: 500; color: var(--ink-soft); width: 34%; }
.cond td.na, .cond tr.obs td { color: var(--ink-soft); }
.note { max-width: 46rem; margin: 18px 0 0; }
.hours { list-style: none; margin: 18px 0 14px; padding: 0; display: grid; grid-template-columns: repeat(12, 1fr); gap: 3px; }
.hours li { text-align: left; font-size: 0.8rem; color: var(--ink-soft); }
.hours .bar { display: block; height: 34px; background: var(--c, var(--rule)); border-radius: 2px; }
.hours .hr { display: block; padding-top: 5px; white-space: nowrap; }
.hours li.past { opacity: 0.35; }
.hours li.now .bar { outline: 2px solid var(--ink); outline-offset: 2px; }
.hours li.now .hr { color: var(--ink); font-weight: 700; }
.days tbody th { width: auto; color: var(--ink); font-weight: 600; }
.small { font-size: 0.92rem; color: var(--ink-soft); }
.status-list { margin: 0; border-top: 1px solid var(--rule); }
.status-list div { display: grid; grid-template-columns: 14rem 1fr; gap: 4px 24px; padding: 13px 0; border-bottom: 1px solid var(--rule); }
.status-list dt { font-weight: 600; }
.status-list dd { margin: 0; }
.good { color: #2e7d32; } .bad { color: var(--red); }
.permit { max-width: 46rem; }
.juris-season { font-weight: 600; }
.permit ul { padding-left: 1.1em; }
.permit li { margin-bottom: 0.6em; }
.checklist { max-width: 46rem; padding-left: 1.2em; }
.checklist li { margin-bottom: 0.5em; }
.how p { max-width: 46rem; }

/* About: apparatus */
.apparatus { display: grid; grid-template-columns: 220px 1fr; gap: 24px; align-items: start; margin: 1em 0 0.5em; }
.apparatus-photo { margin: 0; }
.apparatus-photo img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: 4px; }
.apparatus-list { margin: 0; }
.apparatus-list div + div { margin-top: 1.2em; padding-top: 1.2em; border-top: 1px solid var(--rule); }
.apparatus-list dt { font-weight: 700; font-size: 1.15rem; }
.apparatus-list dd { margin: 0.2em 0 0; }
.soon { font-weight: 500; font-size: 0.9rem; color: var(--ink-soft); margin-left: 0.5em; }

/* Gallery: uncropped photos in columns */
.masonry { list-style: none; margin: 0; padding: 0; columns: 3 300px; column-gap: 18px; }
.masonry li { break-inside: avoid; margin-bottom: 26px; }
.masonry figure { margin: 0; }
.masonry img { width: 100%; border-radius: 4px; }
.masonry figcaption { margin-top: 8px; font-weight: 500; font-size: 1rem; }

/* Form */
.contact-form { display: grid; gap: 6px; max-width: 34rem; }
.contact-form label { font-weight: 600; margin-top: 12px; }
.contact-form .opt { font-weight: 400; color: var(--ink-soft); }
.contact-form input, .contact-form textarea, .contact-form select { font: inherit; font-size: 1rem; padding: 12px 14px; border: 1px solid #b9bcb8; border-radius: 4px; background: #fff; width: 100%; color: var(--ink); }
.contact-form button { justify-self: start; margin-top: 18px; }
.botcheck { display: none; }
.form-status.ok { color: #1d6b2f; font-weight: 600; }
.form-status.err { color: var(--red); }

/* Footer: the original site's charcoal */
.site-foot { position: relative; z-index: 1; background: var(--ink); color: #b2b3b5; font-size: 0.98rem; padding-top: clamp(48px, 7vw, 80px); }
.site-foot a { color: #eaeaea; }
.foot-grid { display: grid; grid-template-columns: 1.5fr 1fr 1fr 1fr; gap: 28px; }
.foot-name { font-weight: 600; font-size: 1.2rem; line-height: 1.25; color: #eaeaea; }
.foot-label { font-weight: 600; color: #eaeaea; margin-bottom: 0.3em; }
.foot-base { border-top: 1px solid #333; margin-top: 40px; padding-top: 18px; padding-bottom: calc(28px + env(safe-area-inset-bottom)); font-size: 0.88rem; color: #8d8e90; }

@media (max-width: 900px) {
  .hero-bg img { object-position: 41% 60%; }
  .response, .join-inner, .contact, .burn-home-inner { grid-template-columns: 1fr; }
  .status-list div { grid-template-columns: 1fr; }
  .contact { min-height: 0; }
  .mosaic { grid-template-columns: 1fr 1fr; grid-template-rows: none; grid-auto-rows: 44vw; max-height: none; }
  .mosaic li:first-child { grid-column: span 2; grid-row: auto; }
  .mosaic li:last-child { grid-column: span 2; }
  .foot-grid { grid-template-columns: 1fr 1fr; }
}
@media (max-width: 600px) {
  .apparatus { grid-template-columns: 1fr; }
  .masonry { columns: 2; column-gap: 10px; }
  .masonry li { margin-bottom: 16px; }
  .masonry figcaption { font-size: 0.85rem; line-height: 1.35; margin-top: 5px; }
}
@media (max-width: 560px) {
  html { scroll-padding-top: 72px; }
  body { font-size: 1.0625rem; }
  .hero-words { padding-top: 180px; }
  .addr-grid, .foot-grid, .contact-facts, .contact-form .row { grid-template-columns: 1fr; }
  .contact-facts div:last-child { grid-column: auto; }
  .mosaic { grid-auto-rows: 40vw; }
  .cond { font-size: 0.95rem; }
  .cond tbody th { width: 38%; }
  .rating-scale { font-size: 0.75rem; }
  .hours { gap: 2px; }
  .hours .bar { height: 28px; }
  .hours li { font-size: 0.7rem; }
  .hours li:nth-child(even) .hr { visibility: hidden; }
}
